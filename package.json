{
  "name": "moon-timer",
  "version": "1.0.0",
  "description": "Moon Timer - odaklanma zamanlayıcısı, istatistik ve konu takibi",
  "main": "main.js",
  "license": "MIT",
  "author": "Moon Timer contributors",
  "homepage": "https://github.com/omer552745/Moon-timer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omer552745/Moon-timer.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.moontimer.app",
    "productName": "Moon Timer",
    "files": [
      "main.js",
      "index.html",
      "icons/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/moon-timer.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Moon-Timer-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Moon-Timer-Portable.${ext}"
    }
  }
}